<theme:ThemedWindow x:Class="AspectUtils.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:AspectUtils.Desktop.Theme"
        Title="A$PECT UTILS"
        Width="1320"
        Height="840"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AspectUtils.ico"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#121619"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/AspectUtils.png" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="A$PECT"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MintBrush}"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="UTILS"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="14,0,14,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource MintBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Administrator"
                                       Margin="8,0,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="VersionText"
                                   Margin="15,3,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="NavList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Dashboard"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="install">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Install apps"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="tweaks">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Tweaks"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="fixes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Fixes"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="features">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Windows features"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="updates">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Windows Update"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="log">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Activity log"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="30,26,30,14">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}" Text="Dashboard" />
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Border Background="#1B2821"
                        BorderBrush="#2C4636"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="12,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource MintBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Elevated session"
                                   Margin="7,0,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MintBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <ContentControl x:Name="ContentHost" Grid.Row="1" Margin="30,0,30,24" />

            <Border x:Name="OperationOverlay"
                    Grid.RowSpan="2"
                    Background="#D9101416"
                    Visibility="Collapsed"
                    Panel.ZIndex="20">
                <Border Style="{StaticResource Card}"
                        Width="760"
                        MaxHeight="560"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="22">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="OperationTitle"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="OperationDescription"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,5,0,12" />
                            <ProgressBar x:Name="OperationProgress"
                                         IsIndeterminate="True"
                                         Margin="0,0,0,14" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,16,0,0">
                            <Button x:Name="OperationCancelButton"
                                    Content="Cancel"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="96"
                                    Margin="0,0,10,0"
                                    Click="OperationCancelButton_Click" />
                            <Button x:Name="OperationCloseButton"
                                    Content="Close"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="104"
                                    Visibility="Collapsed"
                                    Click="OperationCloseButton_Click" />
                        </StackPanel>

                        <Border Background="#101315"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBox x:Name="OperationOutput"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11.5"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12"
                                     MinHeight="260" />
                        </Border>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</theme:ThemedWindow>
