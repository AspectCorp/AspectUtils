<UserControl x:Class="AspectUtils.Desktop.Views.QuickresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Instant resolution switching for stretched res (Valorant and other games)."
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="Requires the target resolution to be registered as a custom resolution in your GPU driver first. SnapRes is the full-featured original; this tab covers the common presets."
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720">
                <TextBlock Text="Current resolution"
                           Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="CurrentResolutionText"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MintBrush}"
                           Margin="0,0,0,16" />

                <TextBlock Text="Preset resolutions"
                           Style="{StaticResource SectionTitle}" />
                <WrapPanel x:Name="PresetsPanel"
                           Margin="0,0,0,20" />

                <TextBlock Text="Custom resolution"
                           Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox x:Name="WidthBox"
                             Width="100"
                             Padding="8,6"
                             Margin="0,0,8,0" />
                    <TextBlock Text="x"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="HeightBox"
                             Width="100"
                             Padding="8,6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button x:Name="ApplyCustomButton"
                            Content="Apply custom"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Click="ApplyCustomButton_Click" />
                    <Button x:Name="RevertButton"
                            Content="Revert to original"
                            Style="{StaticResource SecondaryButton}"
                            Click="RevertButton_Click" />
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" />

                <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="Need the full feature set?"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="SnapRes (the original tool) adds GPU-driver scaling checks, monitor-driver toggle, and saved profiles. Download it from its GitHub releases page."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,5,0,8" />
                        <Button x:Name="OpenSnapResButton"
                                Content="Open SnapRes on GitHub"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Click="OpenSnapResButton_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
