<UserControl x:Class="AspectUtils.Desktop.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Current policy" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                <TextBlock x:Name="CurrentPolicyText"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="Windows Update settings are machine-wide and need a restart to fully settle."
                           FontSize="11"
                           Foreground="#708078"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <ListBox x:Name="ProfilesList"
                 Grid.Row="1"
                 SelectionChanged="ProfilesList_SelectionChanged"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Root"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,14">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#1C2622" />
                                        <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource MintDeepBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="BorderBrush" Value="#3C5B4A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <Border Style="{StaticResource TinyBadge}"
                                        Background="#1F3B2A"
                                        Visibility="{Binding Recommended, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="RECOMMENDED"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MintBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,5,0,0"
                                       MaxWidth="760"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="&#xE73E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource MintBrush}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="2" Margin="2,12,2,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ApplyButton"
                        Content="Apply profile"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="160"
                        IsEnabled="False"
                        Click="Apply_Click" />
            </StackPanel>
            <TextBlock Text="Restart Windows after applying a profile."
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedText}" />
        </DockPanel>
    </Grid>
</UserControl>
