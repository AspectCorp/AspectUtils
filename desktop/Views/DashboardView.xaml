<UserControl x:Class="AspectUtils.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,0">
            <Border CornerRadius="12"
                    Padding="28,26"
                    BorderBrush="#2C4636"
                    BorderThickness="1"
                    Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E3A2A" Offset="0" />
                        <GradientStop Color="#1B2326" Offset="0.6" />
                        <GradientStop Color="#161A1D" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="A$PECT UTILS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MintBrush}" />
                        <TextBlock Text="Windows, on your terms."
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,6" />
                        <TextBlock Text="Install what you need, strip out what you don't, and keep every change reversible. The same configuration drives both the PowerShell app and this desktop app."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   MaxWidth="680"
                                   HorizontalAlignment="Left"
                                   LineHeight="20" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Install apps"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="18,9"
                                    Margin="0,0,10,0"
                                    Click="GoToInstall_Click" />
                            <Button Content="Browse tweaks"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="16,9"
                                    Margin="0,0,10,0"
                                    Click="GoToTweaks_Click" />
                            <Button Content="Windows Update"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="16,9"
                                    Click="GoToUpdates_Click" />
                        </StackPanel>
                    </StackPanel>
                    <Image Grid.Column="1"
                           Source="Assets/AspectUtils.png"
                           Width="116"
                           Height="116"
                           Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.95"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="AppsCount" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}" />
                        <TextBlock Text="Apps in the catalogue" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="3,0,7,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="TweaksCount" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}" />
                        <TextBlock Text="Reversible tweaks" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7,0,3,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="FeaturesCount" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}" />
                        <TextBlock Text="Windows features" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0,0,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="AppliedCount" Text="—" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}" />
                        <TextBlock Text="Changes tracked here" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="This PC" Style="{StaticResource SectionTitle}" />
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock Text="Windows" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="OsText" Text="—" HorizontalAlignment="Right" FontSize="12" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock Text="WinGet" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="WingetText" Text="Checking…" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock Text="Chocolatey" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="ChocoText" Text="Checking…" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="Undo manifest" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="UndoText" Text="—" HorizontalAlignment="Right" FontSize="12" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Quick actions" Style="{StaticResource SectionTitle}" />
                        <Button Content="Run a repair"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,8"
                                Click="GoToFixes_Click" />
                        <Button Content="Manage Windows features"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,8"
                                Click="GoToFeatures_Click" />
                        <Button Content="Open the activity log"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalContentAlignment="Left"
                                Click="GoToLog_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="A$PECT UTILS is a Windows setup utility. MIT licensed."
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="LogPathText"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,10,0,0"
                               FontFamily="Cascadia Mono, Consolas" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Open log folder"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"
                                Click="OpenLogFolder_Click" />
                        <Button Content="Project page"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenProjectPage_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
