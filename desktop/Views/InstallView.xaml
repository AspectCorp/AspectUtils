<UserControl x:Class="AspectUtils.Desktop.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,10,0">
                    <TextBox x:Name="SearchBox"
                             TextChanged="SearchBox_TextChanged"
                             Padding="12,7" />
                    <TextBlock x:Name="SearchHint"
                               Text="Search by name, description, or package id…"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>

                <ComboBox x:Name="CategoryBox"
                          Grid.Column="1"
                          Width="220"
                          Margin="0,0,10,0"
                          SelectionChanged="CategoryBox_SelectionChanged" />

                <Button Grid.Column="2"
                        Content="Select visible"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="SelectAll_Click" />
                <Button Grid.Column="3"
                        Content="Clear"
                        Style="{StaticResource SecondaryButton}"
                        Click="Clear_Click" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="2,0,2,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="InstallButton"
                        Content="Install selected"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="150"
                        Margin="0,0,10,0"
                        IsEnabled="False"
                        Click="Install_Click" />
                <Button x:Name="UninstallButton"
                        Content="Uninstall selected"
                        Style="{StaticResource DangerButton}"
                        MinWidth="150"
                        IsEnabled="False"
                        Click="Uninstall_Click" />
            </StackPanel>
            <TextBlock x:Name="SelectionText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedText}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <ListBox x:Name="AppsList"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource SelectableCard}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <Border Style="{StaticResource TinyBadge}" Margin="9,0,0,0">
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MintBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0"
                                               MaxHeight="34"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PackageId}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SourceText}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Top"
                                           Margin="14,2,0,0" />
                            </Grid>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText"
                       Text="No apps match this filter."
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
