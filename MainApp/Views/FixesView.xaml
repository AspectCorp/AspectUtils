<UserControl x:Class="AspectUtils.Desktop.Views.FixesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Each fix runs a plain PowerShell script shipped beside the app. Progress and errors appear in the operation window and in the activity log."
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="System repair, Windows Update reset, and network reset can take several minutes. Do not close the window while they run."
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ListBox x:Name="FixesList"
                 Grid.Row="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListItemCard}" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Run fix"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="96"
                                    VerticalAlignment="Center"
                                    Margin="20,0,0,0"
                                    Tag="{Binding}"
                                    Click="RunFix_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
