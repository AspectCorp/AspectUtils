<UserControl x:Class="AspectUtils.Desktop.Views.DriverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Driver Detection" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Detected hardware categories and available package installs." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                <Button x:Name="RefreshButton" Content="Refresh detection" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="RefreshButton_Click" />
            </StackPanel>
        </Border>
        <ListBox x:Name="CategoryList" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListItemCard}" Padding="16,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DetectedText}" FontSize="11" Foreground="{StaticResource MintBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Content="Install" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="100" Click="InstallCategory_Click" Tag="{Binding Key}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
