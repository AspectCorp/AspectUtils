<UserControl x:Class="AspectUtils.Desktop.Views.FeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Optional Windows features are installed from the local Windows image. Enabling usually needs a restart; disabling can remove capabilities other apps depend on."
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="Windows may need to download feature payloads from Windows Update."
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="2,0,2,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="EnableButton"
                        Content="Enable selected"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="150"
                        Margin="0,0,10,0"
                        IsEnabled="False"
                        Click="Enable_Click" />
                <Button x:Name="DisableButton"
                        Content="Disable selected"
                        Style="{StaticResource DangerButton}"
                        MinWidth="150"
                        IsEnabled="False"
                        Click="Disable_Click" />
            </StackPanel>
            <TextBlock x:Name="SelectionText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedText}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <ListBox x:Name="FeaturesList" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource SelectableCard}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <Border Style="{StaticResource TinyBadge}" Margin="9,0,0,0">
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MintBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding FeatureList}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="10.5"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText"
                       Text="No optional features are listed in the configuration."
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="Maintenance actions"
                   Style="{StaticResource SectionTitle}"
                   Margin="2,14,0,8" />

        <ListBox x:Name="ActionsList"
                 Grid.Row="4"
                 MaxHeight="190"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListItemCard}" Padding="13,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding DescriptionVisibility}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Run"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="84"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0"
                                    Tag="{Binding Definition}"
                                    Click="RunAction_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
