<UserControl x:Class="AspectUtils.Desktop.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
            <RadioButton x:Name="TweaksTab"
                         Content="Reversible tweaks"
                         Style="{StaticResource TabButton}"
                         GroupName="TweakTabs"
                         IsChecked="True"
                         Checked="TweaksTab_Checked" />
            <RadioButton x:Name="ActionsTab"
                         Content="One-time actions"
                         Style="{StaticResource TabButton}"
                         GroupName="TweakTabs"
                         Checked="ActionsTab_Checked" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid x:Name="TweaksPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,10,0">
                            <TextBox x:Name="SearchBox"
                                     TextChanged="SearchBox_TextChanged"
                                     Padding="12,7" />
                            <TextBlock x:Name="SearchHint"
                                       Text="Search tweaks…"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="13,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <ComboBox x:Name="CategoryBox"
                                  Grid.Column="1"
                                  Width="220"
                                  Margin="0,0,12,0"
                                  SelectionChanged="CategoryBox_SelectionChanged" />

                        <CheckBox x:Name="AppliedOnlyBox"
                                  Grid.Column="2"
                                  Content="Applied only"
                                  VerticalAlignment="Center"
                                  Checked="AppliedOnlyBox_Changed"
                                  Unchecked="AppliedOnlyBox_Changed" />
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1" Margin="2,0,2,10">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ApplyButton"
                                Content="Apply selected"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="148"
                                Margin="0,0,10,0"
                                IsEnabled="False"
                                Click="Apply_Click" />
                        <Button x:Name="UndoButton"
                                Content="Undo selected"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="140"
                                Margin="0,0,10,0"
                                IsEnabled="False"
                                Click="Undo_Click" />
                        <Button x:Name="UndoAllButton"
                                Content="Undo all tracked changes"
                                Style="{StaticResource SecondaryButton}"
                                IsEnabled="False"
                                Click="UndoAll_Click" />
                    </StackPanel>
                    <TextBlock x:Name="SelectionText"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedText}" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <ListBox x:Name="TweaksList" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource SelectableCard}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <Border Style="{StaticResource TinyBadge}" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MintBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource TinyBadge}"
                                                    Background="#1F3B2A"
                                                    Visibility="{Binding AppliedVisibility}">
                                                <TextBlock Text="APPLIED"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MintBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SupportText}"
                                                   FontSize="10.5"
                                                   Foreground="#708078"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyText"
                               Text="No tweaks match this filter."
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>

                <StackPanel Grid.Row="3" Margin="2,8,2,0">
                    <TextBlock x:Name="AppliedSummary" Style="{StaticResource MutedText}" />
                    <TextBlock Text="Applied status tracks changes made by this desktop app. Tweaks applied by the PowerShell app are not flagged, but Undo selected still restores their original values from the shared config."
                               FontSize="10.5"
                               Foreground="#708078"
                               Margin="0,3,0,0" />
                    <TextBlock Text="Advanced entries (DNS, Multiplane Overlay, O&amp;O ShutUp10, and the Ultimate Performance profiles) remain in the PowerShell app for this release."
                               FontSize="10.5"
                               Foreground="#708078"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ActionsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#231F14"
                        BorderBrush="#4A3E1F"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,10">
                    <TextBlock Text="One-time actions run immediately. They are not tracked by the undo manifest and cannot be reverted here."
                               FontSize="12"
                               Foreground="{StaticResource WarningBrush}" />
                </Border>

                <ListBox x:Name="ActionsList" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListItemCard}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <Border Style="{StaticResource TinyBadge}" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MintBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Run"
                                            Style="{StaticResource SecondaryButton}"
                                            MinWidth="84"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0"
                                            Tag="{Binding Definition}"
                                            Click="RunAction_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
