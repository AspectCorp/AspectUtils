<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AspectUtils</AssemblyName>
    <RootNamespace>AspectUtils.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AspectUtils.ico</ApplicationIcon>
    <Version>2.1.1</Version>
    <Authors>A$PECT UTILS contributors</Authors>
    <Company>A$PECT UTILS</Company>
    <Product>A$PECT UTILS</Product>
    <Description>Install apps, tweak Windows with undo, run fixes, and manage updates from one window.</Description>
    <Copyright>A$PECT UTILS</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <Content Include="..\PowerShellApp\config\*.json" Link="config\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Scripts\*.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\AspectUtils.png" />
    <Resource Include="Assets\AspectUtils.ico" />
    <Content Include="Theme\*.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
