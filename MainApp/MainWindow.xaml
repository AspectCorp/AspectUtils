<theme:ThemedWindow x:Class="AspectUtils.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:AspectUtils.Desktop.Theme"
        Title="A$PECT UTILS"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AspectUtils.ico"
        Background="#0B0F0D"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#0F1512"
                BorderBrush="#1C2A22"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,26">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/AspectUtils.png"
                               Width="40"
                               Height="40"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="A$PECT"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MintBrush}"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="UTILS"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="{StaticResource MintBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Administrator session"
                                   Margin="8,0,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText"
                               Margin="14,0,0,0"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <ListBox x:Name="NavList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="NavList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Dashboard"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="install">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Install apps"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="tweaks">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Tweaks"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="fixes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Fixes"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="features">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Windows features"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="updates">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Windows Update"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="quickres">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Quickres"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="driver">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE76E;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Drivers"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavButton}" Tag="log">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;"
                                       Style="{StaticResource NavIcon}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <TextBlock Text="Activity log"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="40,34,40,22">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitle}" Text="Dashboard" />
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,7,0,0">
                    <Ellipse Width="6"
                             Height="6"
                             Fill="{StaticResource MintBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="Elevated"
                               Margin="7,0,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Grid>

            <ContentControl x:Name="ContentHost" Grid.Row="1" Margin="40,0,40,34" />

            <Grid x:Name="OperationOverlay"
                  Grid.RowSpan="2"
                  Background="#F20A0E0C"
                  Visibility="Collapsed"
                  Panel.ZIndex="20">
                <Border Width="620"
                        MaxHeight="640"
                        Padding="32,28"
                        Background="#121A15"
                        BorderBrush="#26382E"
                        BorderThickness="1"
                        CornerRadius="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{StaticResource MintBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="A$PECT UTILS"
                                           Margin="8,0,0,0"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="6"
                                         Height="6"
                                         Fill="{StaticResource MintBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="OperationState"
                                           Text="Working"
                                           Margin="7,0,0,0"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MintBrush}" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MinHeight="220">
                            <Grid Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <Ellipse Stroke="#24332B" StrokeThickness="3" />
                                <Ellipse x:Name="OperationSpinner"
                                         Stroke="{StaticResource MintBrush}"
                                         StrokeThickness="3"
                                         StrokeDashArray="1.8 3.2"
                                         StrokeStartLineCap="Round"
                                         StrokeEndLineCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="OperationSpinnerRotate" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="OperationSpinnerRotate"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0"
                                                                     To="360"
                                                                     Duration="0:0:0.9" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>

                            <TextBlock x:Name="OperationTitle"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="OperationDescription"
                                       Style="{StaticResource MutedText}"
                                       MaxWidth="470"
                                       Margin="0,9,0,0"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       LineHeight="19" />
                        </StackPanel>

                        <StackPanel x:Name="OperationDetailsPanel"
                                    Grid.Row="2"
                                    Margin="0,22,0,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="Details"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="2,0,0,7" />
                            <TextBox x:Name="OperationOutput"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11"
                                     Background="#0A0F0C"
                                     BorderThickness="0"
                                     Height="150"
                                     Padding="12" />
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,24,0,0">
                            <Button x:Name="OperationCancelButton"
                                    Content="Cancel"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="104"
                                    Margin="0,0,10,0"
                                    Click="OperationCancelButton_Click" />
                            <Button x:Name="OperationCloseButton"
                                    Content="Close"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="120"
                                    Visibility="Collapsed"
                                    Click="OperationCloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</theme:ThemedWindow>
