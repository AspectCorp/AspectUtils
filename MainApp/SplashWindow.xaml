<Window x:Class="AspectUtils.Desktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="420"
        Height="260"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid>
        <Border CornerRadius="16"
                Background="#161A1D"
                BorderBrush="#4ADE80"
                BorderThickness="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="72" Height="72" Margin="0,0,0,16">
                    <Ellipse Stroke="#303A35" StrokeThickness="4" />
                    <Ellipse Stroke="#4ADE80" StrokeThickness="4"
                             StrokeDashArray="2 4">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" CenterX="36" CenterY="36" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="A"
                               FontFamily="Segoe UI Black"
                               FontSize="40"
                               FontWeight="Black"
                               Foreground="#4ADE80"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="A$PECT UTILS"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#F3F6F4"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Loading..."
                           FontSize="12"
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
