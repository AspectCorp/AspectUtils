{
  "categories": {
    "chipset": {
      "label": "Chipset / Motherboard",
      "wmi_class": "Win32_PNPDevice",
      "wmi_filter": "ClassGuid LIKE '%{4d36e97d-e325-11ce-bfc1-08002be10318}%'",
      "packages": ["Intel-Chipset-Device-Software", "AMD-Chipset-Software"]
    },
    "audio": {
      "label": "Audio / Sound",
      "wmi_class": "Win32_SoundDevice",
      "packages": ["Realtek.Audio.Driver", "Realtek-HD-Audio-Driver"]
    },
    "gpu": {
      "label": "GPU / Graphics",
      "wmi_class": "Win32_VideoController",
      "packages": ["NVIDIA.Graphics.Driver", "AMD.Radeon.Driver"]
    },
    "network": {
      "label": "Network / Internet",
      "wmi_class": "Win32_NetworkAdapter",
      "packages": ["Intel.Network.Driver", "Realtek-Network-Driver"]
    }
  }
}
